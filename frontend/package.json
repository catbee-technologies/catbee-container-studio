{
  "name": "catbee-container-studio",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "prelint:fix": "npm run format",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write --log-level silent \"**/*.{ts,html,scss,css}\" \"!**/*.min.css\"",
    "preversion": "node -e \"console.error('Do not run npm version from frontend directory.\\nRun it from the project root.\\n'); process.exit(1)\""
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@ng-catbee/loader": "^22.0.0",
    "@ng-catbee/monaco-editor": "^22.0.0",
    "@ng-catbee/storage": "^22.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.5.1",
    "highlight.js": "^11.12.0",
    "monaco-editor": "^0.56.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@eslint/js": "^10.0.1",
    "@types/dockerode": "^4.0.1",
    "angular-eslint": "22.2.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.69.0"
  }
