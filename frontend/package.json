{
  "name": "catbee-container-studio",
  "version": "1.0.0-rc.7",
  "homepage": "https://catbee.in/catbee-container-studio",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "prelint:fix": "npm run format",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write --log-level silent \"**/*.{ts,html,scss,css}\" \"!**/*.min.css\"",
    "preversion": "node -e \"console.error('Do not run npm version from frontend directory.\\nRun it from the project root.\\n'); process.exit(1)\""
  },
  "private": true,
  "packageManager": "npm@12.2.3",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@ng-catbee/loader": "^22.2.0",
    "@ng-catbee/monaco-editor": "^22.1.0",
    "@ng-catbee/storage": "^22.2.0",
    "@tanstack/angular-virtual": "^6.1.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.6.1",
    "highlight.js": "^11.12.0",
    "monaco-editor": "^0.57.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@eslint/js": "^10.0.1",
    "@types/dockerode": "^4.0.2",
    "angular-eslint": "22.8.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.18"
    }
  }
